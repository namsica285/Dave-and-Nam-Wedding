---
// A hand-drawn copper map of the area around the venue. Few places, each label on its own clear patch of paper.
// Positions come from real coordinates (x = longitude, y = latitude, same scale), so distances are honest.
import FoilDefs from './FoilDefs.astro';
import Lotus from './Lotus.astro';
import type { Locale } from '../i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const P = (lat: number, lon: number) => [+(20 + (lon + 111.15) * 845).toFixed(1), +(50 + (32.48 - lat) * 1000).toFixed(1)] as const;
const venue = P(32.37, -110.97);
const tus = P(32.116, -110.941), town = P(32.222, -110.975), park = P(32.426, -110.937), lemmon = P(32.443, -110.788), gates = P(32.222, -111.1);
const route = `M${tus[0]} ${tus[1]} C190 372 172 340 ${town[0]} ${town[1]} C166 262 170 214 ${venue[0]} ${venue[1] + 4}`;
const t = (en: string, vi: string) => (lang === 'en' ? en : vi);
const mile = 1000 / 69; // map units per mile
---
<svg class="amap" viewBox="0 0 400 480" role="img" aria-labelledby="amap-t">
  <title id="amap-t">{t('Map: the venue is north of Tucson at the foot of the Santa Catalina Mountains, about 30 minutes from the airport.', 'Bản đồ: nơi tổ chức nằm ở phía bắc Tucson, dưới chân dãy Santa Catalina, cách sân bay khoảng 30 phút.')}</title>
  <FoilDefs id="foil-map" w={400} light />
  <!-- the Santa Catalina ridge, high above everything else, drawn as you arrive -->
  <g class="ridges" fill="none" stroke="url(#foil-map)" stroke-width="1.8" stroke-linecap="round" data-draw>
    <path pathLength="1" d="M178 150 C204 122 232 100 262 86 C290 74 304 52 328 46 C352 40 372 60 396 76" />
  </g>
  <text class="range" x="396" y="30" text-anchor="end">{t('Santa Catalina Mountains', 'Dãy Santa Catalina')}</text>

  <!-- the way in: airport, through town, north on Oracle Road -->
  <path class="route" d={route} />

  <g class="pin"><circle cx={park[0]} cy={park[1]} r="3.8" /><text x={park[0] - 11} y={park[1] + 5} text-anchor="end">{t('Catalina State Park', 'Công viên Catalina')}</text></g>
  <g class="pin"><circle cx={lemmon[0]} cy={lemmon[1]} r="3.8" /><text x={lemmon[0]} y={lemmon[1] + 27} text-anchor="middle">{t('Mount Lemmon', 'Núi Lemmon')}</text></g>
  <g class="pin"><circle cx={town[0]} cy={town[1]} r="3.8" /><text x={town[0] + 12} y={town[1] + 5}>{t('Downtown Tucson', 'Trung tâm Tucson')}</text></g>
  <g class="pin"><circle cx={tus[0]} cy={tus[1]} r="3.8" /><text x={tus[0] + 12} y={tus[1] + 5}>{t('Tucson airport (TUS)', 'Sân bay Tucson (TUS)')}</text></g>
  <g class="pin"><circle cx={gates[0]} cy={gates[1]} r="3.8" /><text x={gates[0]} y={gates[1] - 14} text-anchor="middle">{t('Gates Pass', 'Đèo Gates')}</text><text class="sub" x="6" y={gates[1] + 26}>{t('Tucson Mountains', 'Dãy Tucson')}</text></g>

  <Lotus gid="foil-map-lotus" x={venue[0] - 20} y={venue[1] - 38} size={40} light sw={3.6} />
  <text class="venue" x={venue[0] - 24} y={venue[1] - 6} text-anchor="end"><tspan x={venue[0] - 24}>The Buttes</tspan><tspan x={venue[0] - 24} dy="21">at Reflections</tspan></text>

  <g class="scale" transform="translate(228 440)">
    <path d={`M0 0 H${(10 * mile).toFixed(1)} M0 -4 V4 M${(10 * mile).toFixed(1)} -4 V4`} />
    <text x={(5 * mile).toFixed(1)} y="24" text-anchor="middle">{t('10 miles · 16 km', '10 dặm · 16 km')}</text>
  </g>
  <g class="north" transform="translate(368 330)">
    <path d="M0 18 V-14 M-5 -6 L0 -14 L5 -6" />
    <text x="0" y="36" text-anchor="middle">N</text>
  </g>
</svg>
<style>
  .amap{--halo:#E5D1BB;display:block;width:100%;height:auto;max-width:34rem;overflow:visible;font-family:var(--font-body)}
  .ridges path{stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--draw,1))}
  .route{fill:none;stroke:var(--copper-ink);stroke-width:1.5;stroke-dasharray:1 5;stroke-linecap:round}
  .pin circle{fill:var(--ivory);stroke:var(--copper-ink);stroke-width:1.7}
  .pin text,.venue,.range,.scale text,.north text{paint-order:stroke;stroke:var(--halo);stroke-width:5px;stroke-linejoin:round}
  .pin text{font-size:17px;font-weight:500;fill:var(--green)}
  .pin .sub,.range{font-family:var(--font-display);font-style:italic;font-size:14.5px;font-weight:400;fill:var(--copper-ink)}
  .venue{font-family:var(--font-display);font-size:18px;fill:var(--green)}
  .scale path,.north path{fill:none;stroke:var(--copper-ink);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
  .scale text,.north text{font-size:14px;font-weight:600;fill:var(--copper-ink);letter-spacing:.04em}
</style>
