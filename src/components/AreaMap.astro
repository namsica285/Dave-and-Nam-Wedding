---
// A hand-drawn copper map of the area around the venue. Six places at most, so it stays a drawing, not a pin board.
// Positions are real coordinates projected to the drawing (x = longitude * cos(32.3°), y = latitude), so distances are honest.
import FoilDefs from './FoilDefs.astro';
import Lotus from './Lotus.astro';
import type { Locale } from '../i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const P = (lat: number, lon: number) => [+(20 + (lon + 111.15) * 845).toFixed(1), +(20 + (32.48 - lat) * 1000).toFixed(1)] as const;
const venue = P(32.37, -110.97);
const places = [
  { at: P(32.116, -110.941), en: 'Tucson airport (TUS)', vi: 'Sân bay Tucson (TUS)', dx: 10, dy: 5 },
  { at: P(32.222, -110.975), en: 'Downtown Tucson', vi: 'Trung tâm Tucson', dx: 10, dy: 5 },
  { at: P(32.426, -110.937), en: 'Catalina State Park', vi: 'Công viên Catalina', dx: 10, dy: 22 },
  { at: P(32.443, -110.788), en: 'Mount Lemmon', vi: 'Núi Mount Lemmon', dx: 0, dy: -14, end: true },
  { at: P(32.222, -111.1), en: 'Gates Pass', vi: 'Đèo Gates Pass', dx: 0, dy: -12, mid: true },
];
const route = `M${places[0].at[0]} ${places[0].at[1]} C190 340 172 312 ${places[1].at[0]} ${places[1].at[1]} C166 236 168 186 ${venue[0]} ${venue[1]}`;
const t = (o: { en: string; vi: string }) => o[lang];
const mile = 1000 / 69; // map units per mile
---
<svg class="amap" viewBox="0 0 400 440" role="img" aria-labelledby="amap-t">
  <title id="amap-t">{lang === 'en' ? 'Map: the venue is north of Tucson at the foot of the Santa Catalina Mountains, about 30 minutes from the airport.' : 'Bản đồ: nơi tổ chức nằm ở phía bắc Tucson, dưới chân dãy Santa Catalina, cách sân bay khoảng 30 phút.'}</title>
  <FoilDefs id="foil-map" w={400} light />
  <!-- Santa Catalina range and Tucson Mountains: ridges, drawn as you arrive -->
  <g class="ridges" fill="none" stroke="url(#foil-map)" stroke-width="1.6" stroke-linecap="round" data-draw>
    <path pathLength="1" d="M176 146 C192 118 208 108 228 100 C250 91 270 82 292 70 C312 59 330 52 350 60 C368 67 382 82 396 96" />
    <path pathLength="1" d="M190 132 C206 122 224 122 240 116 C262 108 280 104 300 96 C322 88 344 92 364 104" opacity=".55" />
    <path pathLength="1" d="M36 214 C48 236 56 256 64 280 C72 304 82 326 96 350" />
  </g>
  <text class="range" x="396" y="132" text-anchor="end">{lang === 'en' ? 'Santa Catalina Mountains' : 'Dãy Santa Catalina'}</text>
  <text class="range" x="22" y="224">{lang === 'en' ? 'Tucson Mountains' : 'Dãy Tucson'}</text>
  <!-- the way in: airport, through town, north on Oracle Road -->
  <path class="route" d={route} />
  {places.map((p) => (
    <g>
      <circle class="pt" cx={p.at[0]} cy={p.at[1]} r="3.6" />
      <text class="lbl" x={p.at[0] + p.dx} y={p.at[1] + p.dy} text-anchor={p.end ? 'end' : p.mid ? 'middle' : 'start'}>{t(p)}</text>
    </g>
  ))}
  <Lotus gid="foil-map-lotus" x={venue[0] - 20} y={venue[1] - 38} size={40} light sw={3.6} />
  <text class="lbl venue" x={venue[0] - 20} y={venue[1] - 2} text-anchor="end"><tspan x={venue[0] - 20}>The Buttes</tspan><tspan x={venue[0] - 20} dy="21">at Reflections</tspan></text>
  <!-- scale and north -->
  <g class="scale" transform="translate(230 404)">
    <path d={`M0 0 H${(10 * mile).toFixed(1)} M0 -4 V4 M${(10 * mile).toFixed(1)} -4 V4`} />
    <text x={(5 * mile).toFixed(1)} y="22" text-anchor="middle">{lang === 'en' ? '10 miles · 16 km' : '10 dặm · 16 km'}</text>
  </g>
  <g class="north" transform="translate(366 300)">
    <path d="M0 18 V-14 M-5 -6 L0 -14 L5 -6" />
    <text x="0" y="32" text-anchor="middle">N</text>
  </g>
</svg>
<style>
  .amap{display:block;width:100%;height:auto;max-width:34rem;overflow:visible;font-family:var(--font-body)}
  .ridges path{stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--draw,1))}
  .route{fill:none;stroke:var(--copper-ink);stroke-width:1.4;stroke-dasharray:1 5;stroke-linecap:round}
    .pt{fill:var(--ivory);stroke:var(--copper-ink);stroke-width:1.6}
  .lbl{font-size:16px;font-weight:500;fill:var(--green)}
  .venue{font-family:var(--font-display);font-size:18px;fill:var(--green)}
  .range{font-size:14px;font-style:italic;font-family:var(--font-display);fill:var(--copper-ink);letter-spacing:.02em}
  .scale path,.north path{fill:none;stroke:var(--copper-ink);stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
  .scale text,.north text{font-size:14px;font-weight:600;fill:var(--copper-ink);letter-spacing:.04em}
</style>
