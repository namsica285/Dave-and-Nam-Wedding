---
import { ui, type Locale } from '../i18n/ui';
const { lang } = Astro.props as { lang: Locale };
const t = ui[lang];
---
<footer>
  <div class="wrap">
    <hr class="foil-line" />
    <p class="line"><span lang={lang}>{t.footer}</span></p>
    <p class="meta">{t.date} · {t.place}</p>
  </div>
</footer>
<style>
  footer{padding:3rem 0 2.5rem;text-align:center;margin-top:4rem}
  .line{font-family:var(--font-display);font-size:var(--step-1);margin:1.5rem auto .25rem}
  .meta{font:500 var(--step--1)/1.4 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:var(--copper-deep);margin:0 auto}
</style>
