---
// Copper foil gradient. JS (sky.ts) slides it with scroll so the highlight travels along every line.
interface Props { id: string; w?: number; light?: boolean }
const { id, w = 400, light = false } = Astro.props;
// On ivory the pale highlight vanishes, so light backgrounds get a deeper foil.
const c = light ? ['#6E4529','#9D6B48','#C4916F','#B07C58','#9D6B48','#6E4529'] : ['#86573B','#B68360','#F4DAC1','#EBD1BC','#B68360','#86573B'];
---
<defs>
  <linearGradient id={id} data-foil gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={w} y2="0" spreadMethod="repeat" data-w={w}>
    <stop offset="0" stop-color={c[0]} />
    <stop offset=".3" stop-color={c[1]} />
    <stop offset=".5" stop-color={c[2]} />
    <stop offset=".62" stop-color={c[3]} />
    <stop offset=".8" stop-color={c[4]} />
    <stop offset="1" stop-color={c[5]} />
  </linearGradient>
</defs>
