---
// Where the sun (or moon) stands in this chapter of the day. Drawn in copper beside each chapter heading.
interface Props { phase: 'morning' | 'midday' | 'golden' | 'night' }
const { phase } = Astro.props;
const angle = { morning: 155, midday: 90, golden: 22, night: 0 }[phase];
const r = 22, cx = 30, cy = 28;
const x = +(cx + r * Math.cos((angle * Math.PI) / 180)).toFixed(2);
const y = +(cy - r * Math.sin((angle * Math.PI) / 180)).toFixed(2);
---
<svg class="sunmark" viewBox="0 0 60 34" aria-hidden="true" focusable="false">
  <path class="arc" d={`M${cx - r} ${cy} A${r} ${r} 0 0 1 ${cx + r} ${cy}`} />
  <path class="hz" d="M2 28 H58" />
  {phase === 'night'
    ? <path class="moon" d="M33 6 A8 8 0 1 0 41 16 A6.2 6.2 0 1 1 33 6Z" />
    : <circle class="sun" cx={x} cy={y} r="4.2" />}
</svg>
<style>
  .sunmark{width:3.4rem;height:auto;flex:none;overflow:visible}
  .arc{fill:none;stroke:currentColor;stroke-width:1;stroke-dasharray:2 3;opacity:.55}
  .hz{fill:none;stroke:currentColor;stroke-width:1.25;stroke-linecap:round}
  .sun,.moon{fill:currentColor}
</style>
