---
import FoilDefs from './FoilDefs.astro';
interface Props {
  gid: string;          // unique gradient id
  open?: number;        // 0 closed .. 1 open (1.15 = full bloom)
  draw?: boolean;       // draw the outline in on load
  delay?: number;       // seconds before the draw starts
  light?: boolean;      // use the deeper foil on ivory
  sw?: number;          // stroke width in viewBox units
  class?: string;
  x?: number; y?: number; size?: number; // when nested inside another svg
}
const { gid, open = 1, draw = false, delay = 0, sw = 2, light = false, x, y, size } = Astro.props;
const petals = [
  { a: -55, l: 0.82 }, { a: 55, l: 0.82 },
  { a: -27, l: 0.92 }, { a: 27, l: 0.92 },
  { a: 0, l: 1 },
];
const nested = x !== undefined ? { x, y, width: size, height: size } : {};
---
<svg viewBox="0 0 100 100" class:list={['lotus', Astro.props.class]} style={`--open:${open}`} aria-hidden="true" focusable="false" {...nested}>
  <FoilDefs id={gid} w={100} light={light} />
  {petals.map((p, i) => (
    <g class="rot" style={`--a:${p.a}`}>
      <path
        class:list={['petal', { drawn: draw }]}
        style={draw ? `animation-delay:${delay + i * 0.18}s` : undefined}
        pathLength="1"
        transform={`translate(50 92) scale(${p.l}) translate(-50 -92)`}
        d="M50 92 C37 70 37 38 50 10 C63 38 63 70 50 92 Z"
        fill="#D7B5A1" fill-opacity=".2"
        stroke={`url(#${gid})`} stroke-width={sw} stroke-linejoin="round"
      />
    </g>
  ))}
</svg>
<style>
  .lotus{overflow:visible;display:block}
  .rot{transform-box:view-box;transform-origin:50px 92px;transform:rotate(calc(var(--a) * var(--open) * 1deg))}
  .petal.drawn{stroke-dasharray:1;stroke-dashoffset:1;fill-opacity:0;animation:petal-draw 1.5s cubic-bezier(.65,0,.35,1) both}
  @keyframes petal-draw{to{stroke-dashoffset:0;fill-opacity:.2}}
</style>
