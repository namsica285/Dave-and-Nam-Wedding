---
// Night sky: steady stars, twinkling stars, four-point sparkles and the odd shooting star.
interface Props { count?: number; sparkles?: number; seed?: number; meteors?: boolean; class?: string }
const { count = 220, sparkles = 14, seed: s0 = 11, meteors = true } = Astro.props;
let seed = s0;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: count }, () => {
  const big = rnd() < 0.12;
  return { x: +(rnd() * 1600).toFixed(1), y: +(rnd() * 1000).toFixed(1), r: +(big ? 1.6 + rnd() * 1.2 : 0.5 + rnd() * 1).toFixed(2),
    tw: rnd() < 0.45, dur: +(2.2 + rnd() * 5).toFixed(1), d: +(rnd() * 7).toFixed(1), o: +(0.45 + rnd() * 0.55).toFixed(2) };
});
const sp = Array.from({ length: sparkles }, () => ({ x: +(rnd() * 1600).toFixed(0), y: +(rnd() * 900).toFixed(0), s: +(0.6 + rnd() * 0.9).toFixed(2), dur: +(3 + rnd() * 4).toFixed(1), d: +(rnd() * 8).toFixed(1) }));
---
<svg class:list={['stars', Astro.props.class]} viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id={`glow-${s0}`}><stop offset="0" stop-color="#FFF6EA" /><stop offset=".35" stop-color="#F4DAC1" stop-opacity=".55" /><stop offset="1" stop-color="#F4DAC1" stop-opacity="0" /></radialGradient>
    <linearGradient id={`meteor-${s0}`} x1="0" x2="1"><stop offset="0" stop-color="#F4DAC1" stop-opacity="0" /><stop offset="1" stop-color="#FFF6EA" /></linearGradient>
  </defs>
  <ellipse class="milky" cx="900" cy="380" rx="900" ry="120" transform="rotate(-18 900 380)" fill={`url(#glow-${s0})`} />
  {stars.map((s) => (
    <circle cx={s.x} cy={s.y} r={s.r} fill="#FFF8EE" opacity={s.o} class:list={{ tw: s.tw }} style={s.tw ? `--dur:${s.dur}s;animation-delay:-${s.d}s` : undefined} />
  ))}
  {sp.map((p) => (
    <g transform={`translate(${p.x} ${p.y}) scale(${p.s})`}>
      <g class="spark" style={`--dur:${p.dur}s;animation-delay:-${p.d}s`}>
        <circle r="9" fill={`url(#glow-${s0})`} />
        <path d="M0 -14 C1 -3 3 -1 14 0 C3 1 1 3 0 14 C-1 3 -3 1 -14 0 C-3 -1 -1 -3 0 -14Z" fill="#FFF6EA" />
      </g>
    </g>
  ))}
  {meteors && [0, 1].map((i) => (
    <g class="meteor" style={`animation-delay:${4 + i * 7}s`} transform={`translate(${300 + i * 700} ${80 + i * 60}) rotate(24)`}>
      <rect x="-180" y="-1" width="180" height="2" rx="1" fill={`url(#meteor-${s0})`} />
    </g>
  ))}
</svg>
<style>
  .stars{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .milky{opacity:.10}
  .tw{transform-box:fill-box;transform-origin:center;animation:tw var(--dur) ease-in-out infinite}
  @keyframes tw{0%,100%{opacity:.25;transform:scale(.7)}50%{opacity:1;transform:scale(1.15)}}
  .spark{transform-box:fill-box;transform-origin:center;opacity:0;animation:spark var(--dur) var(--ease-in-out) infinite}
  @keyframes spark{0%,100%{opacity:0;transform:scale(.2) rotate(0)}45%{opacity:1;transform:scale(1) rotate(45deg)}60%{opacity:.9;transform:scale(.85) rotate(60deg)}}
  .meteor{opacity:0;animation:meteor 14s linear infinite}
  @keyframes meteor{0%{opacity:0;translate:0 0}2%{opacity:1}8%{opacity:0;translate:520px 230px}100%{opacity:0;translate:520px 230px}}
  @media (prefers-reduced-motion:reduce){.tw,.spark,.meteor{animation:none}.spark{opacity:.8}}
</style>
