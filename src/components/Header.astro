---
import Monogram from './Monogram.astro';
import ProgressRidge from './ProgressRidge.astro';
import { ui, pages, otherLocale, pageTitles, type Locale } from '../i18n/ui';
interface Props { lang: Locale; page: string; progress?: boolean }
const { lang, page, progress = false } = Astro.props;
const t = ui[lang];
const other = otherLocale(lang);
const here = page ? `/${other}/${page}/` : `/${other}/`;
---
<header class="site-header">
  <div class="bar wrap">
    <a class="brand" href={`/${lang}/`} aria-label="Dave & Nam"><Monogram /></a>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {pages.map((p) => (
          <li><a href={`/${lang}/${p}/`} aria-current={page === p ? 'page' : undefined}>{lang === 'en' ? pageTitles[p][0] : pageTitles[p][1]}</a></li>
        ))}
      </ul>
    </nav>
    <a class="lang" href={here} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{t.langSwitch}</a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">{t.menu}</button>
  </div>
  {progress && <div class="skyline wrap"><ProgressRidge /></div>}
</header>

<style>
  /* The header is a veil over the sky, not a box: it lets the page colour through,
     so it moves from ivory to dune to plum to night together with the page. */
  .site-header{
    position:sticky;top:0;z-index:50;color:var(--hdr-fg,var(--green));
    background:color-mix(in srgb,var(--hdr-tint,var(--ivory)) 62%,transparent);
    -webkit-backdrop-filter:blur(16px) saturate(1.15);backdrop-filter:blur(16px) saturate(1.15);
    border-bottom:1px solid color-mix(in srgb,var(--copper) 28%,transparent);
    transition:color var(--dur-slow) var(--ease-out),background-color 700ms var(--ease-out),border-color 700ms var(--ease-out);
  }
  :global(html[data-tone="dark"]) .site-header{--hdr-tint:var(--night);--hdr-fg:var(--ivory);border-bottom-color:color-mix(in srgb,var(--copper-light) 30%,transparent)}
  .bar{display:flex;align-items:center;gap:1.25rem;min-height:4.5rem}
  .brand{display:block;flex:none}
  .brand :global(.mono){height:3.25rem;width:auto;aspect-ratio:2400/2000}
  nav{margin-left:auto}
  ul{display:flex;gap:clamp(1rem,2vw,2rem);list-style:none;margin:0;padding:0}
  nav a{display:inline-block;padding:.65rem .1rem;text-decoration:none;font:600 var(--step-label)/1.2 var(--font-body);letter-spacing:.08em;text-transform:uppercase;background:linear-gradient(currentColor,currentColor) 0 100%/0 1.5px no-repeat;transition:background-size var(--dur-base) var(--ease-out)}
  nav a[aria-current="page"]{background-size:100% 1.5px}
  @media (hover:hover) and (pointer:fine){nav a:hover{background-size:100% 1.5px}}
  .lang{font:600 var(--step-label)/1.2 var(--font-body);letter-spacing:.04em;text-decoration:none;border:1.5px solid var(--copper);border-radius:999px;padding:.7rem 1.1rem;min-height:48px;display:inline-flex;align-items:center;transition:transform var(--dur-fast) var(--ease-out),background-color var(--dur-base) var(--ease-out)}
  :global(html[data-tone="dark"]) .lang{border-color:var(--copper-light)}
  .lang:active{transform:scale(.97)}
  @media (hover:hover) and (pointer:fine){.lang:hover{background:color-mix(in srgb,var(--copper) 16%,transparent)}}
  .skyline{margin-top:-.15rem;margin-bottom:-1px}
  .menu{display:none}
  @media (max-width:66rem){
    .bar{flex-wrap:wrap;gap:.75rem}
    .lang{margin-left:auto}
    .menu{display:inline-flex;align-items:center;min-height:48px;padding:0 1.1rem;background:none;border:1.5px solid currentColor;border-radius:999px;font:600 var(--step-label)/1 var(--font-body);letter-spacing:.08em;text-transform:uppercase;color:inherit;cursor:pointer}
    .menu:active{transform:scale(.97)}
    nav{order:5;flex-basis:100%;margin:0;display:grid;grid-template-rows:0fr;transition:grid-template-rows var(--dur-base) var(--ease-out)}
    nav ul{overflow:hidden;flex-direction:column;gap:0;min-height:0}
    nav[data-open="true"]{grid-template-rows:1fr;padding-bottom:.75rem}
    nav a{padding:1rem 0;width:100%;font-size:1.0625rem}
  }
  @media (max-width:24rem){.brand :global(.mono){height:2.75rem}.lang,.menu{padding-inline:.85rem}}
</style>

<script>
  function wire() {
    const btn = document.querySelector<HTMLButtonElement>('.site-header .menu');
    const nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = nav.dataset.open !== 'true';
      nav.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });
  }
  document.addEventListener('astro:page-load', wire);
</script>
