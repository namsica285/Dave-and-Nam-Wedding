---
// The sunset: dune into plum behind the Catalina range, with a foil rim on the ridge.
// No text sits on it, so contrast never fails mid-gradient.
import FoilDefs from './FoilDefs.astro';
import Glint from './Glint.astro';
import { smoothStops } from '../lib/gradient';
interface Props { id?: string; compact?: boolean }
const { id = 'foil-range', compact = false } = Astro.props;
const g = smoothStops([['#D1A585', 0], ['#C99573', 0.3], ['#C08464', 0.5], ['#9A6B63', 0.68], ['#6E4F5C', 0.84], ['#4E3D4E', 1]], 14);
const ridge = 'M0 320 C120 280 210 240 310 248 C400 256 450 198 550 190 C640 183 700 238 800 230 C900 222 950 150 1050 142 C1140 135 1200 205 1290 210 C1380 215 1440 175 1520 182 C1560 186 1585 196 1600 200';
---
<div class:list={['blend', { compact }]} data-tone="split:0.5" aria-hidden="true" style={`background:radial-gradient(ellipse 70% 38% at 50% 74%, rgba(255,226,196,.55), rgba(255,226,196,0) 70%), linear-gradient(to bottom, ${g})`}>
  <svg class="range" viewBox="0 0 1600 420" preserveAspectRatio="xMidYMax slice">
    <FoilDefs id={id} w={800} still />
    <path fill="#6E4F5C" fill-opacity=".55" d="M0 250 C140 200 230 150 330 160 C420 170 470 90 590 80 C700 70 760 150 860 140 C960 130 1010 40 1120 50 C1220 60 1270 140 1370 130 C1460 122 1540 90 1600 100 L1600 420 L0 420Z" />
    <path fill="#4E3D4E" d={`${ridge} L1600 420 L0 420Z`} />
    <path class="rim" fill="none" stroke={`url(#${id})`} stroke-width="2" vector-effect="non-scaling-stroke" d={ridge} />
    <g class="rim-glint"><Glint d={ridge} sw={2} dur={16} delay={2} /></g>
  </svg>
</div>
<style>
  .blend{position:relative;height:max(clamp(26rem,85vh,52rem),calc(100vw * .2625 + 14rem))}
  .blend.compact{height:max(clamp(18rem,55vh,34rem),calc(100vw * .2625 + 8rem))}
  .range{position:absolute;left:0;right:0;bottom:-1px;width:100%;height:max(calc(100vw * .2625),42%)}
  .rim-glint :global(path){vector-effect:non-scaling-stroke}
  .rim{filter:drop-shadow(0 0 3px rgba(255,236,214,.55))}
</style>
