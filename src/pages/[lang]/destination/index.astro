---
import Base from '../../../layouts/Base.astro';
import BiHeading from '../../../components/BiHeading.astro';
import LogoLotus from '../../../components/LogoLotus.astro';
import Stage from '../../../components/Stage.astro';
import SunsetBand from '../../../components/SunsetBand.astro';
import SunMark from '../../../components/SunMark.astro';
import RidgeLine from '../../../components/RidgeLine.astro';
import AreaMap from '../../../components/AreaMap.astro';
import { locales, type Locale } from '../../../i18n/ui';
import { event } from '../../../data/event';
import { dest as d } from '../../../data/destination';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const t = (o: { en: string; vi: string }) => o[lang];
const ps = (o: { en: string[]; vi: string[] }) => o[lang];
const mapUrl = event.mapUrl;
const openMap = lang === 'en' ? 'Open in Maps' : 'Mở bản đồ';
const tentative = lang === 'en' ? 'Venue and details are tentative and may change.' : 'Địa điểm và chi tiết là dự kiến, có thể thay đổi.';
---
<Base lang={lang} page="destination" night title={lang === 'en' ? 'Destination' : 'Điểm Đến'} description={lang === 'en' ? 'Tucson and the Sonoran Desert: getting here, where to stay, and what the desert is like in February.' : 'Tucson và sa mạc Sonoran: đường đi, nơi ở, và sa mạc vào tháng Hai.'}>

  <!-- Day: the idea, the reason, and the facts -->
  <Stage sky="day">
    <section class="hero wrap">
      <BiHeading level="h1" en={d.title.en} vi={d.title.vi} {lang} />
      <p class="sub" lang={lang}>{t(d.sub)}</p>
      <RidgeLine gid="foil-ridge" class="ridge" />
      <p class="lede">{t(d.lede)}</p>
    </section>

    <section class="wrap why" aria-labelledby="why-h">
      <BiHeading id="why-h" level="h2" en={d.why.h.en} vi={d.why.h.vi} {lang} />
      <div class="why-body">
        {ps(d.why.p).map((p) => <p>{p}</p>)}
        <p class="quote" lang={lang}>{t(d.why.quote)}</p>
      </div>
    </section>

    <section class="wrap glance" aria-labelledby="glance-h">
      <div class="panel">
        <BiHeading id="glance-h" level="h2" en={d.glance.h.en} vi={d.glance.h.vi} {lang} />
        <dl>
          {d.glance.rows.map((r) => (
            <div class="row">
              <dt>{t(r.k)}</dt>
              <dd>{t(r.v)}</dd>
            </div>
          ))}
        </dl>
        <a class="btn" href={mapUrl} target="_blank" rel="noopener">{openMap}</a>
      </div>
    </section>

    <!-- I. Morning -->
    <section class="wrap chapter" aria-labelledby="morning-h">
      <div class="ch-head"><SunMark phase="morning" /><BiHeading id="morning-h" level="h2" en={d.morning.h.en} vi={d.morning.h.vi} {lang} /></div>
      <div class="cols">
        <div class="essay">
          <BiHeading level="h3" en={d.morning.place.h.en} vi={d.morning.place.h.vi} {lang} />
          {ps(d.morning.place.p).map((p) => <p>{p}</p>)}
          <BiHeading level="h3" en={d.morning.flowers.h.en} vi={d.morning.flowers.h.vi} {lang} class="gap" />
          {ps(d.morning.flowers.p).map((p) => <p>{p}</p>)}
        </div>
        <aside class="practical" aria-labelledby="arrive-h">
          <BiHeading id="arrive-h" level="h3" en={d.morning.arrive.h.en} vi={d.morning.arrive.h.vi} {lang} />
          <dl>
            {d.morning.arrive.items.map((i) => (
              <div class="item"><dt>{t(i.k)}</dt><dd>{t(i.v)}</dd></div>
            ))}
          </dl>
        </aside>
      </div>
    </section>
  </Stage>

  <!-- Midday into golden hour -->
  <Stage sky="golden">
    <section class="wrap chapter" aria-labelledby="midday-h">
      <div class="ch-head"><SunMark phase="midday" /><BiHeading id="midday-h" level="h2" en={d.midday.h.en} vi={d.midday.h.vi} {lang} /></div>
      <div class="cols">
        <div class="essay">
          <BiHeading level="h3" en={d.midday.sky.h.en} vi={d.midday.sky.h.vi} {lang} />
          {ps(d.midday.sky.p).map((p) => <p>{p}</p>)}
          <p class="tip">{t(d.midday.sky.tip)}</p>
        </div>
        <div class="essay">
          <BiHeading level="h3" en={d.midday.table.h.en} vi={d.midday.table.h.vi} {lang} />
          {ps(d.midday.table.p).map((p) => <p>{p}</p>)}
          <BiHeading level="h3" en={d.midday.table.home.h.en} vi={d.midday.table.home.h.vi} {lang} class="gap" />
          <p>{t(d.midday.table.home.p)}</p>
        </div>
      </div>
    </section>

    <section class="wrap chapter last" aria-labelledby="golden-h">
      <div class="ch-head"><SunMark phase="golden" /><BiHeading id="golden-h" level="h2" en={d.golden.h.en} vi={d.golden.h.vi} {lang} /></div>
      <div class="cols">
        <div class="essay">
          <BiHeading level="h3" en={d.golden.light.h.en} vi={d.golden.light.h.vi} {lang} />
          {ps(d.golden.light.p).map((p) => <p>{p}</p>)}
          <BiHeading level="h3" en={d.golden.venue.h.en} vi={d.golden.venue.h.vi} {lang} class="gap" />
          {ps(d.golden.venue.p).map((p) => <p>{p}</p>)}
          <p class="soft">{tentative}</p>
          <a class="btn venue-btn" href={mapUrl} target="_blank" rel="noopener">{openMap}</a>
        </div>
        <figure class="mapfig">
          <AreaMap {lang} />
          <figcaption>{t(d.golden.venue.mapNote)}</figcaption>
        </figure>
      </div>
    </section>
  </Stage>

  <SunsetBand compact id="foil-range-dest" />

  <!-- Dusk and night: the dark sky, the words, the invitation to stay -->
  <Stage sky="dusk" seed={21}>
    <section class="wrap chapter" aria-labelledby="night-h">
      <div class="ch-head"><SunMark phase="night" /><BiHeading id="night-h" level="h2" en={d.night.h.en} vi={d.night.h.vi} {lang} dark /></div>
      <div class="cols">
        <div class="essay">
          <BiHeading level="h3" en={d.night.dark.h.en} vi={d.night.dark.h.vi} {lang} dark />
          {ps(d.night.dark.p).map((p) => <p>{p}</p>)}
        </div>
        <div class="essay words">
          <BiHeading level="h3" en={d.night.words.h.en} vi={d.night.words.h.vi} {lang} dark />
          <dl>
            {d.night.words.list.map((w) => (
              <div class="word">
                <dt>{w.t}{w.say && <span class="say"> · {w.say}</span>}</dt>
                <dd>{t(w)}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </Stage>

  <Stage sky="night" seed={33}>
    <section class="wrap close" aria-labelledby="after-h">
      <div class="closing">
        {ps(d.closing.p).map((p) => <p>{p}</p>)}
      </div>
      <LogoLotus gid="foil-dest-close" open={0.2} sw={24} wash={false} class="close-lotus" data-open-from="0.15" data-open-to="1" />
      <BiHeading id="after-h" level="h2" en={d.after.h.en} vi={d.after.h.vi} {lang} dark />
      <p class="teaser">{t(d.after.teaser)}</p>
      <div class="btns">
        <a class="btn" href={`/${lang}/destination/after-the-vows/`}>{t(d.after.cta)}</a>
        <a class="btn" href={`/${lang}/rsvp/`}>{lang === 'en' ? 'Kindly Reply' : 'Hồi Âm'}</a>
      </div>
    </section>
  </Stage>
</Base>

<style>
  :global(main h1){font-size:var(--step-4)}
  :global(main h2){font-size:var(--step-3)}
  :global(main h3){font-size:var(--step-1)}
  p{max-width:var(--measure)}

  .hero{display:grid;gap:1rem;padding-block:clamp(3rem,8vw,6rem) clamp(1.5rem,4vw,3rem)}
  .sub{font-family:var(--font-display);font-style:italic;font-size:var(--step-1);color:var(--copper-ink);margin:0}
  .hero :global(.ridge){margin-block:clamp(.5rem,2vw,1.5rem)}
  .lede{font-family:var(--font-display);font-size:var(--step-1);line-height:1.5;max-width:44rem;margin:0}

  .why{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;padding-block:clamp(2rem,5vw,4rem)}
  .why-body p:not(.quote){margin-bottom:1.1em}
  .quote{font-family:var(--font-display);font-style:italic;font-size:var(--step-1);line-height:1.4;color:var(--copper-ink);margin:1.75rem 0 0;max-width:34rem}
  @media (min-width:60rem){.why{grid-template-columns:minmax(0,22rem) minmax(0,1fr);gap:clamp(2rem,6vw,5rem)}}

  .glance{padding-block:clamp(1rem,3vw,2rem) clamp(3rem,7vw,5rem)}
  .panel{display:grid;gap:1.5rem;padding:clamp(1.5rem,4vw,2.5rem);border:1.5px solid color-mix(in srgb,var(--copper) 55%,transparent);border-radius:18px;background:color-mix(in srgb,var(--ivory) 55%,white);justify-items:start}
  .panel :global(h2){font-size:var(--step-2)}
  dl{margin:0}
  .panel dl{display:grid;gap:0;width:100%}
  .row{display:grid;gap:.25rem;padding-block:1rem;border-top:1px solid color-mix(in srgb,var(--copper) 35%,transparent)}
  dt{font:600 var(--step-label)/1.3 var(--font-body);letter-spacing:.08em;text-transform:uppercase;color:var(--copper-ink)}
  dd{margin:0;white-space:pre-line}
  @media (min-width:44rem){.row{grid-template-columns:11rem minmax(0,1fr);gap:1.5rem}}

  .chapter{padding-block:clamp(2.5rem,5.5vw,4.5rem)}
  .chapter.last{padding-bottom:clamp(4rem,9vw,7rem)}
  .ch-head{display:flex;align-items:center;gap:clamp(1rem,3vw,1.75rem);margin-bottom:clamp(1.75rem,4vw,3rem);color:var(--copper-ink)}
  .ch-head :global(.bi){color:var(--fg)}
  .cols{display:grid;gap:clamp(2rem,5vw,3.5rem);grid-template-columns:minmax(0,1fr)}
  @media (min-width:64rem){.cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(3rem,6vw,6rem);align-items:start}}
  .essay :global(.gap){margin-top:2.25rem}
  .essay :global(h3){margin-bottom:.9rem}
  .essay p{margin-bottom:1.1em}
  .tip{padding:1rem 1.25rem;border:1.5px solid color-mix(in srgb,var(--copper) 45%,transparent);border-radius:12px;background:color-mix(in srgb,var(--ivory) 40%,transparent)}
  .soft{color:var(--muted)}

  .practical{padding:clamp(1.25rem,3vw,1.75rem);border:1.5px solid color-mix(in srgb,var(--copper) 45%,transparent);border-radius:16px;background:color-mix(in srgb,var(--ivory) 55%,white);align-self:start}
  .practical :global(h3){margin-bottom:.5rem}
  .item{padding-block:.95rem;border-top:1px solid color-mix(in srgb,var(--copper) 30%,transparent)}
  .item:first-child{border-top:0}
  .item dd{white-space:normal;margin-top:.2rem}

  .venue-btn{margin-top:.5rem}
  .mapfig{margin:0;display:grid;gap:.75rem;justify-items:start}
  .mapfig figcaption{font-size:var(--step--1);color:var(--muted)}

  /* dark chapters: the light line motifs only, ivory text */
  .words dl{display:grid;gap:0}
  .word{padding-block:.85rem;border-top:1px solid color-mix(in srgb,var(--copper-light) 35%,transparent)}
  .word:first-child{border-top:0;padding-top:.2rem}
  .word dt{color:var(--copper-light);letter-spacing:.06em;text-transform:none;font-size:var(--step-0);font-weight:600}
  .word .say{font-weight:500;color:#E6C3A5}
  .word dd{margin-top:.15rem}

  .close{position:relative;display:grid;justify-items:center;text-align:center;gap:1.25rem;padding-block:clamp(4rem,10vw,7rem)}
  .closing{display:grid;gap:1rem;justify-items:center;margin-bottom:1.5rem}
  .closing p{font-family:var(--font-display);font-size:var(--step-1);line-height:1.5;margin:0;max-width:40rem;text-wrap:balance}
  .closing p:last-child{color:#E6C3A5;font-style:italic}
  :global(.close-lotus){width:7rem;height:7.6rem}
  .teaser{max-width:38rem;margin:0 auto}
  .btns{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;margin-top:.5rem}
</style>
