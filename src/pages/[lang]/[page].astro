---
import Base from '../../layouts/Base.astro';
import BiHeading from '../../components/BiHeading.astro';
import { ui, locales, pages, pageTitles, type Locale, type PageSlug } from '../../i18n/ui';
export function getStaticPaths() {
  return locales.flatMap((lang) => pages.filter((p) => p !== 'details' && p !== 'gifts' && p !== 'rsvp').map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as Locale;
const page = Astro.params.page as PageSlug;
const [en, vi] = pageTitles[page];
---
<Base lang={lang} page={page} title={lang === 'en' ? en : vi}>
  <section class="wrap stub">
    <BiHeading level="h1" {en} {vi} {lang} />
    <hr class="foil-line" />
    <p>{ui[lang].soon}</p>
  </section>
</Base>
<style>
  .stub{padding-block:clamp(3rem,8vw,6rem);display:grid;gap:1.5rem}
  h1{font-size:var(--step-3)}
  .foil-line{width:6rem}
</style>
