---
import Base from '../../layouts/Base.astro';
import { ui, locales, type Locale } from '../../i18n/ui';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const t = ui[lang];
---
<Base lang={lang} title={lang === 'en' ? 'Dave & Nam' : 'Dave & Nam'}>
  <section class="hero wrap">
    <img src="/brand/DN-monogram-light.webp" width="1200" height="1000" alt="DN monogram with a copper-line lotus" class="mark" />
    <h1 class="names">Dave &amp; Nam</h1>
    <hr class="foil-line" />
    <p class="when">{t.date}<br />{t.place}</p>
    <a class="btn" href={`/${lang}/rsvp/`}>{lang === 'en' ? 'Kindly Reply' : 'Hồi Âm'}</a>
  </section>
</Base>
<style>
  .hero{display:grid;justify-items:center;text-align:center;gap:1.25rem;padding-block:clamp(2rem,6vw,5rem)}
  .mark{width:min(88vw,30rem);height:auto}
  .names{font-size:var(--step-4)}
  .hero .foil-line{width:min(60%,14rem)}
  .when{font:500 var(--step--1)/1.9 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:var(--copper-deep);margin:0}
</style>
