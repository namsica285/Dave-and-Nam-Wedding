---
import Base from '../../layouts/Base.astro';
import BiHeading from '../../components/BiHeading.astro';
import LogoLotus from '../../components/LogoLotus.astro';
import DuneLine from '../../components/DuneLine.astro';
import Stars from '../../components/Stars.astro';
import { smoothStops } from '../../lib/gradient';
import { ui, locales, type Locale } from '../../i18n/ui';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const S = {
  en: {
    lead: 'Please enter the four-character code on your invitation.',
    label: 'Invitation code', hint: 'Four letters and numbers, printed on your invitation.', go: 'Continue',
    hello: 'Welcome, {name}', q: 'Will you be joining us?', yes: 'Joyfully accepts', no: 'Regretfully declines',
    many: 'How many will attend?', cap: 'Your invitation includes up to {max}.', email: 'Email (optional)', emailHint: 'For updates about the day.',
    send: 'Send Reply', other: 'Not your invitation? Use a different code', sending: 'Sending…',
    prior: 'You replied before: {answer}. You can change it below until January 15, 2028.',
    priorYes: 'joyfully accepts, {n} attending', priorNo: 'regretfully declines',
    thanksYes: 'Thank you. We can’t wait to celebrate with you.', thanksNo: 'Thank you for letting us know. You will be missed, and we are grateful for your love.',
    again: 'Come back with the same code to change your reply any time before January 15, 2028.',
    practice: 'Practice mode: nothing is being saved yet.',
    e_code: 'We couldn’t find that code. Please check your invitation and try again.', e_locked: 'Too many tries. Please wait an hour, or write to us and we will help.',
    e_server: 'Something went wrong on our end. Please try again in a moment.', e_pick: 'Please choose whether you can join us.', e_email: 'That email doesn’t look right. Please check it, or leave it blank.',
  },
  vi: {
    lead: 'Xin nhập mã gồm bốn ký tự trên thiệp mời của quý vị.',
    label: 'Mã thiệp mời', hint: 'Gồm bốn chữ và số, ghi trên thiệp mời.', go: 'Tiếp tục',
    hello: 'Xin chào, {name}', q: 'Quý vị có thể đến dự không?', yes: 'Hân hạnh tham dự', no: 'Rất tiếc, không thể đến',
    many: 'Có bao nhiêu người sẽ đến?', cap: 'Thiệp mời dành cho tối đa {max} người.', email: 'Email (không bắt buộc)', emailHint: 'Để nhận thông tin về ngày cưới.',
    send: 'Gửi Hồi Âm', other: 'Không phải thiệp của quý vị? Nhập mã khác', sending: 'Đang gửi…',
    prior: 'Quý vị đã hồi âm trước đó: {answer}. Có thể thay đổi bên dưới trước ngày 15 tháng 1, 2028.',
    priorYes: 'hân hạnh tham dự, {n} người', priorNo: 'rất tiếc không thể đến',
    thanksYes: 'Cảm ơn quý vị. Chúng tôi rất mong được chung vui cùng quý vị.', thanksNo: 'Cảm ơn quý vị đã cho chúng tôi biết. Chúng tôi sẽ nhớ quý vị và biết ơn tình cảm của quý vị.',
    again: 'Quý vị có thể quay lại với cùng mã này để thay đổi hồi âm trước ngày 15 tháng 1, 2028.',
    practice: 'Chế độ thử nghiệm: chưa có gì được lưu.',
    e_code: 'Chúng tôi không tìm thấy mã này. Xin kiểm tra lại thiệp mời và thử lại.', e_locked: 'Quý vị đã thử quá nhiều lần. Xin chờ một giờ, hoặc liên hệ chúng tôi để được giúp.',
    e_server: 'Đã có trục trặc ở phía chúng tôi. Xin thử lại sau giây lát.', e_pick: 'Xin chọn quý vị có thể đến dự hay không.', e_email: 'Email này chưa đúng. Xin kiểm tra lại, hoặc để trống.',
  },
}[lang];
// The whole sky of the wedding day in one tall strip. After a reply it slides up: ivory, gold, sunset, dusk, night.
const sweep = smoothStops([['#EEECDD', 0], ['#EEECDD', 0.2], ['#E6D3BD', 0.32], ['#D1A585', 0.42], ['#B97A62', 0.5], ['#7A5263', 0.57], ['#4E3D4E', 0.64], ['#3F3443', 0.71], ['#2E2A36', 0.78], ['#2E2A36', 1]], 18);
---
<Base lang={lang} page="rsvp" title={lang === 'en' ? 'Kindly Reply' : 'Hồi Âm'}>
  <section class="stage stage-day sky-stage" id="sky" data-tone="light">
    <div class="sweep" aria-hidden="true" style={`background:linear-gradient(to bottom, ${sweep})`}></div>
    <Stars count={200} sparkles={12} seed={21} class="rsvp-stars" />
    <section class="wrap rsvp" id="rsvp" data-s={JSON.stringify(S)}>
      <div class="top" id="top">
        <DuneLine gid="foil-rsvp-dune" light sw={13} class="rsvp-dune" />
        <BiHeading level="h1" en="Kindly Reply" vi="Hồi Âm" {lang} />
        <p class="by">{t.replyBy}</p>
      </div>
      <p class="practice" id="practice" hidden><b>{S.practice}</b></p>

      <form id="code-form" class="card" novalidate>
        <p class="lead">{S.lead}</p>
        <label for="code">{S.label}</label>
        <input id="code" name="code" maxlength="6" autocomplete="off" autocapitalize="characters" spellcheck="false" enterkeyhint="go" aria-describedby="code-hint" />
        <p class="hint" id="code-hint">{S.hint}</p>
        <button class="btn" type="submit">{S.go}</button>
        <p class="err" id="code-err" role="alert"></p>
      </form>

      <form id="reply-form" class="card" hidden novalidate>
        <h2 id="hello"></h2>
        <p class="prior" id="prior" hidden></p>
        <fieldset>
          <legend>{S.q}</legend>
          <div class="choices">
            <label class="choice"><input type="radio" name="attending" value="yes" /><span><i aria-hidden="true">✓</i>{S.yes}</span></label>
            <label class="choice"><input type="radio" name="attending" value="no" /><span><i aria-hidden="true">✓</i>{S.no}</span></label>
          </div>
        </fieldset>
        <div id="many-box" hidden>
          <label for="count">{S.many}</label>
          <select id="count" name="count"></select>
          <p class="hint" id="cap"></p>
        </div>
        <div>
          <label for="email">{S.email}</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="120" aria-describedby="email-hint" />
          <p class="hint" id="email-hint">{S.emailHint}</p>
        </div>
        <button class="btn" type="submit" id="send">{S.send}</button>
        <p class="err" id="reply-err" role="alert"></p>
        <button class="linkish" type="button" id="other">{S.other}</button>
      </form>

      <div id="thanks" class="card thanks-card" hidden tabindex="-1" aria-live="polite">
        <LogoLotus gid="foil-rsvp" open={0.15} sw={24} class="rsvp-lotus" data-rsvp-lotus="1" />
        <h2 id="thanks-h"></h2>
        <p class="hint" id="thanks-sub"></p>
        <hr class="foil-line" />
      </div>
    </section>
  </section>
</Base>

<script>
  type H = { name: string; max: number; attending?: 'yes' | 'no'; count?: number; email?: string; code: string; practice: boolean };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function init() {
    const root = document.getElementById('rsvp');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const S = JSON.parse(root.dataset.s!);
    const codeForm = $<HTMLFormElement>('code-form'), replyForm = $<HTMLFormElement>('reply-form'), thanks = $('thanks');
    const codeIn = $<HTMLInputElement>('code'), codeErr = $('code-err'), replyErr = $('reply-err');
    const count = $<HTMLSelectElement>('count'), manyBox = $('many-box'), emailIn = $<HTMLInputElement>('email');
    let house: H | null = null;

    const post = async (body: object) => {
      const r = await fetch('/api/rsvp/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      return { status: r.status, data: await r.json().catch(() => ({})) };
    };
    const errText = (e: string) => (e === 'locked' ? S.e_locked : e === 'code' ? S.e_code : e === 'email' ? S.e_email : e === 'attending' ? S.e_pick : S.e_server);
    const show = (el: HTMLElement) => { for (const x of [codeForm, replyForm, thanks]) x.hidden = x !== el; };

    async function lookup(code: string) {
      codeErr.textContent = '';
      const btn = codeForm.querySelector('button')!; btn.disabled = true;
      try {
        const { status, data } = await post({ action: 'lookup', code });
        if (status !== 200) { codeErr.textContent = errText(data.error); return; }
        house = data as H;
        $('practice').hidden = !house.practice;
        $('hello').textContent = fill(S.hello, { name: house.name });
        count.replaceChildren(...Array.from({ length: house.max }, (_, i) => new Option(String(i + 1), String(i + 1))));
        $('cap').textContent = fill(S.cap, { max: house.max });
        if (house.attending) {
          const a = house.attending === 'yes' ? fill(S.priorYes, { n: house.count ?? 1 }) : S.priorNo;
          $('prior').textContent = fill(S.prior, { answer: a }); $('prior').hidden = false;
          (replyForm.querySelector(`input[name=attending][value=${house.attending}]`) as HTMLInputElement).checked = true;
          if (house.attending === 'yes' && house.count) count.value = String(Math.min(house.count, house.max));
        } else if (house.max === 1) { count.value = '1'; }
        if (house.email) emailIn.value = house.email;
        sync(); show(replyForm); $('hello').scrollIntoView({ block: 'center', behavior: still() ? 'auto' : 'smooth' });
      } catch { codeErr.textContent = S.e_server; } finally { btn.disabled = false; }
    }
    const sync = () => { manyBox.hidden = (replyForm.querySelector('input[name=attending]:checked') as HTMLInputElement | null)?.value !== 'yes'; };

    codeForm.addEventListener('submit', (e) => { e.preventDefault(); const c = codeIn.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); if (c.length < 4) { codeErr.textContent = S.e_code; return; } lookup(c); });
    codeIn.addEventListener('input', () => { codeIn.value = codeIn.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); codeErr.textContent = ''; });
    replyForm.addEventListener('change', sync);
    $('other').addEventListener('click', () => { house = null; replyForm.reset(); $('prior').hidden = true; show(codeForm); codeIn.focus(); });

    replyForm.addEventListener('submit', async (e) => {
      e.preventDefault(); if (!house) return;
      replyErr.textContent = '';
      const attending = (replyForm.querySelector('input[name=attending]:checked') as HTMLInputElement | null)?.value;
      if (!attending) { replyErr.textContent = S.e_pick; return; }
      const btn = $<HTMLButtonElement>('send'), label = btn.textContent; btn.disabled = true; btn.textContent = S.sending;
      try {
        const { status, data } = await post({ action: 'submit', code: house.code, attending, count: attending === 'yes' ? Number(count.value) : 0, email: emailIn.value });
        if (status !== 200) { replyErr.textContent = errText(data.error); return; }
        $('thanks-h').textContent = attending === 'yes' ? S.thanksYes : S.thanksNo;
        $('thanks-sub').textContent = S.again;
        nightfall();
      } catch { replyErr.textContent = S.e_server; } finally { btn.disabled = false; btn.textContent = label; }
    });

    // Day turns to night: the reply fades, the sky slides from ivory through sunset to stars,
    // then the lotus opens with the thank-you. The dune stays behind in the daylight.
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    async function nightfall() {
      const sky = $('sky'), top = $('top');
      const calm = still();
      sky.classList.add('fading');                       // form and dune fade out
      await wait(calm ? 250 : 550);
      top.hidden = true; $('practice').hidden = true;
      show(thanks); thanks.classList.add('pre');
      sky.classList.add('night', 'stage-dark'); sky.dataset.tone = 'dark';
      document.body.classList.add('tone-night'); document.documentElement.dataset.toneDefault = 'dark';
      window.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
      window.dispatchEvent(new Event('scroll'));          // header follows the sky
      await wait(calm ? 200 : 2300);                      // the sky finishes its sweep, stars arrive
      sky.classList.remove('fading'); thanks.classList.remove('pre');
      thanks.focus({ preventScroll: true });
      bloom();
    }

    // the lotus opens as the thank-you appears
    function bloom() {
      const el = document.querySelector<SVGElement>('[data-rsvp-lotus]'); if (!el) return;
      if (still()) { el.style.setProperty('--open', '1'); return; }
      const t0 = performance.now(), D = 2600;
      const step = (now: number) => { const p = Math.min(1, (now - t0) / D); el.style.setProperty('--open', (0.15 + 0.85 * (1 - (1 - p) ** 3)).toFixed(3)); if (p < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    }

    const pre = new URLSearchParams(location.search).get('code');
    if (pre) { codeIn.value = pre.toUpperCase().replace(/[^A-Z0-9]/g, ''); if (codeIn.value.length >= 4) lookup(codeIn.value); }
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  h1{font-size:var(--step-3)}
  .sky-stage{min-height:100svh;background:var(--ivory)}
  .sweep{position:absolute;pointer-events:none;left:0;right:0;top:0;height:420%;transform:translateY(0);will-change:transform;transition:transform 2.8s cubic-bezier(.55,0,.25,1)}
  .sky-stage.night .sweep{transform:translateY(-76.2%)}
  :global(.rsvp-stars){opacity:0;transition:opacity 1.6s var(--ease-out) 1.4s;-webkit-mask-image:linear-gradient(to bottom,#000 70%,transparent);mask-image:linear-gradient(to bottom,#000 70%,transparent)}
  .sky-stage.night :global(.rsvp-stars){opacity:1}
  .rsvp > *{transition:opacity .5s var(--ease-out)}
  .sky-stage.fading .rsvp > *{opacity:0}
  .top{display:grid;gap:1.1rem;justify-items:center;text-align:center;width:100%}
  .top[hidden]{display:none}
  .top :global(.rsvp-dune){width:min(100%,28rem);margin:0 auto .5rem}
  :global(.rsvp-dune .dl){stroke-dasharray:1;stroke-dashoffset:1;animation:dune-draw 2.4s cubic-bezier(.45,0,.2,1) .2s forwards}
  :global(.rsvp-dune .dl-fold){animation-delay:1.1s;animation-duration:1.6s}
  @keyframes dune-draw{to{stroke-dashoffset:0}}
  h2{font-size:var(--step-2)}
  .rsvp{position:relative;display:grid;gap:1.25rem;justify-items:start;padding-block:clamp(3rem,8vw,5.5rem) clamp(4rem,9vw,7rem);max-width:40rem}
  .by{font:600 var(--step-label)/1.4 var(--font-body);letter-spacing:.1em;text-transform:uppercase;color:var(--copper-ink);margin:0}
  .practice{margin:0;padding:.7rem 1rem;border:1.5px dashed #B8641B;border-radius:12px;background:#FFF1E0;color:#6B3A0E;font-size:var(--step--1)}
  .card{width:100%;display:grid;gap:1rem;padding:clamp(1.25rem,4vw,2rem);border:1.5px solid color-mix(in srgb,var(--copper) 55%,transparent);border-radius:20px;background:#FFFDF7;margin-top:.5rem}
  .card[hidden],#many-box[hidden],.practice[hidden],.prior[hidden]{display:none}
  .lead{margin:0;font-family:var(--font-display);font-size:var(--step-1);line-height:1.3}
  label,legend{font:600 var(--step--1)/1.3 var(--font-body);letter-spacing:.08em;text-transform:uppercase;color:var(--copper-ink);padding:0}
  fieldset{border:0;margin:0;padding:0;display:grid;gap:.9rem}
  input[type=text],input:not([type]),input[type=email],select{width:100%;min-height:3.5rem;padding:.7rem 1rem;font:500 1.1875rem/1.2 var(--font-body);color:var(--green);background:#fff;border:1.5px solid var(--green);border-radius:14px}
  #code{font-family:var(--font-display);font-size:2rem;letter-spacing:.35em;text-transform:uppercase;text-align:center;max-width:15rem}
  input:focus-visible,select:focus-visible{outline:3px solid var(--copper-deep);outline-offset:2px}
  .hint{margin:0;font-size:var(--step--1);color:var(--muted)}
  .err{margin:0;min-height:1.5em;font-weight:600;color:#7A3B00}
  .err:not(:empty)::before{content:"! ";font-weight:700}
  .choices{display:grid;gap:.7rem}
  .choice{display:block;cursor:pointer;text-transform:none;letter-spacing:0;font-weight:500;font-size:var(--step-0);color:var(--green)}
  .choice input{position:absolute;opacity:0;width:1px;height:1px}
  .choice span{display:flex;align-items:center;gap:.8rem;min-height:3.5rem;padding:.7rem 1.1rem;border:1.5px solid var(--copper);border-radius:14px;background:#fff;transition:background-color var(--dur-base) var(--ease-out),border-color var(--dur-base) var(--ease-out)}
  .choice i{font-style:normal;width:1.6rem;height:1.6rem;display:grid;place-items:center;border:1.5px solid var(--copper);border-radius:50%;color:transparent;font-size:1rem}
  .choice input:checked + span{background:#E7EEF7;border:2.5px solid #1F4E8C;font-weight:600}
  .choice input:checked + span i{background:#1F4E8C;border-color:#1F4E8C;color:#fff}
  .choice input:focus-visible + span{outline:3px solid var(--copper-deep);outline-offset:2px}
  .prior{margin:0;padding:.8rem 1rem;border-radius:12px;background:#EEF3FA;border:1px solid #1F4E8C;color:var(--green)}
  .btn{justify-self:start}
  .btn:disabled{opacity:.6;cursor:progress}
  .linkish{justify-self:start;background:none;border:0;padding:.6rem 0;min-height:48px;font:500 var(--step--1)/1.3 var(--font-body);color:var(--copper-ink);text-decoration:underline;text-underline-offset:.25em;cursor:pointer}
  .thanks-card{justify-items:center;text-align:center;gap:1.3rem;outline:none;background:none;border:0;padding-block:clamp(2rem,8vh,5rem) 0}
  .thanks-card h2{font-size:var(--step-2);line-height:1.25;text-wrap:balance;max-width:34rem}
  .thanks-card.pre{opacity:0}
  .thanks-card{transition:opacity 1.2s var(--ease-out)}
  :global(.rsvp-lotus){width:10rem;height:10.8rem}
  .thanks-card .foil-line{width:min(12rem,60%)}
  @media (prefers-reduced-motion:reduce){.choice span{transition:none}
    .sweep{transition:opacity .4s linear}
    :global(.rsvp-dune .dl){animation:none;stroke-dashoffset:0}
    :global(.rsvp-stars){transition-delay:0s}}
</style>
