---
import Base from '../../layouts/Base.astro';
import BiHeading from '../../components/BiHeading.astro';
import LogoLotus from '../../components/LogoLotus.astro';
import Stage from '../../components/Stage.astro';
import SunsetBand from '../../components/SunsetBand.astro';
import DuneLine from '../../components/DuneLine.astro';
import { ui, locales, type Locale } from '../../i18n/ui';
import { event } from '../../data/event';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const other = lang === 'en' ? 'vi' : 'en';
const copy = {
  tea: {
    en: 'A Vietnamese tradition at the heart of our ceremony: we serve tea to our parents and elders to thank them and receive their blessing.',
    vi: 'Một truyền thống Việt Nam ở trung tâm hôn lễ: chúng con dâng trà lên cha mẹ và ông bà để tỏ lòng biết ơn và nhận lời chúc phúc.',
  },
  reception: { en: 'Dinner, dancing and desert skies to follow.', vi: 'Sau đó là tiệc tối, khiêu vũ và bầu trời sa mạc.' },
  menu: { en: 'Our menu will be shared here soon.', vi: 'Thực đơn sẽ sớm được cập nhật tại đây.' },
  travel: { en: 'Travel and lodging details are coming soon: nearby hotels, getting there, and what to pack for a February evening in the desert.', vi: 'Thông tin đi lại và lưu trú sẽ sớm có: khách sạn gần đó, cách đến nơi, và nên mang gì cho một buổi tối tháng Hai trên sa mạc.' },
};
---
<Base lang={lang} page="details" night title={lang === 'en' ? 'Details' : 'Chi Tiết'}>
  <!-- Day: the facts, in plain afternoon light -->
  <Stage sky="day">
  <section class="top">
    <div class="wrap">
      <BiHeading level="h1" en="Details" vi="Chi Tiết" {lang} />
      <p class="tent">{t.tentative}</p>
    </div>
  </section>

  <section class="wrap facts" aria-label={lang === 'en' ? 'When and where' : 'Thời gian và địa điểm'}>
    <div class="fact">
      <BiHeading level="h2" en="When" vi="Thời Gian" {lang} />
      <p class="big">{event.date[lang]}</p>
      <p>{t.timesTba}<br />{event.sunset[lang]}</p>
    </div>
    <div class="fact">
      <BiHeading level="h2" en="Where" vi="Địa Điểm" {lang} />
      <p class="big">{event.venue}</p>
      <p>{event.place}</p>
      <a class="btn" href={event.mapUrl} target="_blank" rel="noopener">{t.openMap}</a>
    </div>
  </section>

  </Stage>

  <!-- Golden hour: the ceremony happens as the light turns warm -->
  <Stage sky="golden">
  <section class="wrap order" aria-labelledby="order-h">
    <BiHeading id="order-h" level="h2" en="Order of Ceremony" vi="Nghi Thức Hôn Lễ" {lang} />
    <ol>
      {event.ceremony.map((c) => {
        const tea = c.en === 'Tea Ceremony';
        return (
          <li class:list={{ tea }}>
            {tea
              ? <LogoLotus gid="foil-tea" open={1} sw={30} light class="tea-lotus" />
              : <svg class="mark" viewBox="-14 -14 28 28" aria-hidden="true"><path d="M0 -12 C1 -3 3 -1 12 0 C3 1 1 3 0 12 C-1 3 -3 1 -12 0 C-3 -1 -1 -3 0 -12Z" /></svg>}
            <div>
              <span class="name" lang={lang}>{c[lang]}</span>
              <span class="alt" lang={other}>{c[other]}</span>
              {tea && <p class="note">{copy.tea[lang]}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  </Stage>

  <SunsetBand compact id="foil-range-d" />

  <!-- Dusk: dinner and dancing under the first stars -->
  <Stage sky="dusk" seed={9}>
  <section class="wrap duo">
    <div>
      <BiHeading level="h2" en="Reception" vi="Tiệc Cưới" {lang} dark />
      <p>{copy.reception[lang]}</p>
      <p class="soft">{copy.menu[lang]}</p>
    </div>
    <div>
      <BiHeading level="h2" en="Travel & Stay" vi="Đi Lại & Lưu Trú" {lang} dark />
      <p class="soft">{copy.travel[lang]}</p>
    </div>
  </section>

  </Stage>

  <!-- Night: the reply, under the full desert sky -->
  <Stage sky="night" seed={13}>
  <section class="wrap reply">
    <DuneLine gid="foil-reply-dune" sw={10} class="reply-dune" data-draw />
    <p>{event.rsvpBy[lang]}</p>
    <a class="btn" href={`/${lang}/rsvp/`}>{lang === 'en' ? 'Kindly Reply' : 'Hồi Âm'}</a>
  </section>
  </Stage>
</Base>

<style>
  h1{font-size:var(--step-3)}
  h2{font-size:var(--step-2)}
  .top{padding-block:clamp(3rem,8vw,5.5rem) clamp(1rem,3vw,2rem)}
  .tent{margin-top:1.5rem;padding:.9rem 1.2rem;border:1px solid color-mix(in srgb,var(--copper) 45%,transparent);border-radius:14px;background:color-mix(in srgb,var(--ivory) 70%,transparent);color:var(--copper-ink);max-width:44rem}

  .facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:clamp(2rem,5vw,4rem);padding-block:clamp(3rem,7vw,5rem)}
  .fact{display:grid;gap:.6rem;align-content:start}
  .fact p{margin:0}
  .big{font-family:var(--font-display);font-size:var(--step-1);line-height:1.25;margin-top:.6rem!important}
  .fact .btn{justify-self:start;margin-top:.9rem}

  .order{padding-block:clamp(3rem,7vw,5rem) clamp(4rem,9vw,7rem)}
  ol{list-style:none;margin:2.5rem 0 0;padding:0;display:grid;gap:1.6rem;position:relative;max-width:40rem}
  /* the copper thread runs between the marks, never under them */
  li:not(:last-child)::after{content:"";position:absolute;left:1.15rem;top:2.1rem;bottom:-1.3rem;width:2px;background:var(--foil-v) 0 0/100% 480px repeat-y;animation:glint-v 9s linear infinite}
  li.tea:not(:last-child)::after{top:3.2rem}
  li:has(+ li.tea)::after{bottom:-.9rem}
  @keyframes glint-v{to{background-position:0 480px}}
  li{display:grid;grid-template-columns:2.4rem 1fr;gap:1.1rem;align-items:start;position:relative}
  .mark{width:1.1rem;height:1.1rem;margin:.35rem 0 0 .65rem;fill:var(--copper)}
  :global(.tea-lotus){width:3.2rem;height:3.5rem;margin-left:-.35rem;margin-top:-.6rem}
  .name{display:block;font-family:var(--font-display);font-size:var(--step-1);line-height:1.2}
  .alt{display:block;color:var(--copper-ink);font-weight:500;margin-top:.1rem}
  .note{margin:.6rem 0 0;color:var(--muted)}
  li.tea .name{color:var(--green)}

  .duo{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:clamp(2rem,5vw,4rem);padding-block:clamp(3rem,7vw,5rem)}
  .duo p{margin:1rem 0 0}
  .soft{color:var(--muted)}

  .reply{display:grid;justify-items:center;text-align:center;gap:1.25rem;padding-block:clamp(4rem,10vw,7rem)}
  .reply :global(.reply-dune){width:min(80%,24rem);margin:0 auto .5rem}
  .reply :global(.reply-dune .dl){stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--draw,1));filter:drop-shadow(0 0 6px rgba(255,230,205,.5))}
  .reply p{margin:0;font-family:var(--font-display);font-size:var(--step-1);text-wrap:balance}
  @media (prefers-reduced-motion:reduce){li::after{animation:none}}
</style>
