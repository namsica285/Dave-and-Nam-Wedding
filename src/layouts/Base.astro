---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props { lang: Locale; title: string; page?: string; description?: string; night?: boolean }
const { lang, title, page = '', night = false, description = 'Dave & Nam, February 18, 2028, Oro Valley, Arizona' } = Astro.props;
const t = ui[lang];
// link previews need a full address: the Vercel preview URL until the real domain is connected
const host = process.env.VERCEL_ENV === 'production' || !process.env.VERCEL_BRANCH_URL ? Astro.site!.origin : `https://${process.env.VERCEL_BRANCH_URL}`;
const og = `${host}/og.jpg`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#EEECDD" />
    <title>{title} · Dave & Nam</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Dave & Nam" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/noto-serif-display-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body class:list={{ 'tone-night': night }}>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer lang={lang} />
    <script>import '../scripts/sky.ts';</script>
  </body>
</html>
